# Environment Variables

# --- Browser (safe to expose; Row Level Security decides what they can reach)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server only. NEVER prefix these with VITE_, or they end up in the bundle.
# Needed by /api/team so an Admin can create teammate logins from
# Team & access. Supabase dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --- Daily reminder email (Settings -> Alerts & reminders)
# Pick ONE provider. Without either, the reminder runs and reports that it
# could not send, rather than pretending it did.
#   Resend: an API key from resend.com, with your sending domain verified there
RESEND_API_KEY=
#   or any SMTP server, e.g. Gmail with an app password:
#   smtps://you@yourcompany.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
# The From address. Must belong to the verified domain or the SMTP account.
ALERT_FROM=Timely Payment <alerts@yourcompany.com>
# Proves a request to /api/daily-report came from Vercel's scheduler.
CRON_SECRET=

GEMINI_API_KEY=
