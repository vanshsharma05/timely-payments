# Environment Variables

# --- Browser (safe to expose; Row Level Security decides what they can reach)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server only. NEVER prefix these with VITE_, or they end up in the bundle.
# Needed by /api/team so an Admin can create teammate logins from
# Team & access. Supabase dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=
